{
  "schemaVersion": "2.0.0",
  "domain": "nutrition_physiology_and_adaptive_coaching",
  "adrCompliance": "ADR-0006 (Zero synthetic numbers; null when untabulated; discrete certified bioavailability tiers)",
  "sources": {
    "USDA_RF6": {
      "code": "USDA_RF6",
      "citation": "U.S. Department of Agriculture (USDA), Agricultural Research Service (2007). USDA Table of Nutrient Retention Factors, Release 6.",
      "scope": "Vitamin and mineral retention factors across boiling (drained vs retained), steaming, pan-searing/sautéing, and stewing."
    },
    "BOGNAR_2002": {
      "code": "BOGNAR_2002",
      "citation": "Bognár, A. (2002). Tables on Weight Yield of Food and Retention Factors of Food Constituents for the Calculation of Nutrient Composition of Cooked Foods (Dishes). Bundesforschungsanstalt für Ernährung (BfEL), Karlsruhe.",
      "scope": "Physical cooked weight yields and mineral leaching in discarded cooking water vs retained broth/risottatura."
    },
    "LARN_V_2024": {
      "code": "LARN_V_2024",
      "citation": "SINU — Società Italiana di Nutrizione Umana (2024). LARN — Livelli di Assunzione di Riferimento di Nutrienti ed energia per la popolazione italiana, V Revisione.",
      "scope": "Italian reference intakes (AR, PRI, AI, SDT, UL) and personalized energy/macro/micronutrient targets."
    },
    "EFSA_DRV": {
      "code": "EFSA_DRV",
      "citation": "EFSA NDA Panel (2010–2019). Dietary Reference Values for nutrients; EFSA CONTAM Panel (2012) Scientific Opinion on Methylmercury TWI (1.3 μg/kg bw).",
      "scope": "European reference intakes, EPA+DHA cardiovascular targets (250 mg/day), and predatory fish mercury guardrails."
    },
    "WEAVER_1999_CA": {
      "code": "WEAVER_1999_CA",
      "citation": "Weaver, C. M., Proulx, W. R., & Heaney, R. (1999). Choices for achieving adequate dietary calcium with a vegetarian diet. AJCN, 70(3), 543S–548S.",
      "scope": "Discrete calcium fractional absorption classes: low-oxalate brassicas (>30–40%) vs high-oxalate spinach/chard (<10%)."
    },
    "HALLBERG_2000_FE": {
      "code": "HALLBERG_2000_FE",
      "citation": "Hallberg, L., & Hulthén, L. (2000). Prediction of dietary iron absorption: an algorithm for calculating absorption and bioavailability of dietary iron. AJCN, 71(5), 1147–1160.",
      "scope": "Heme vs non-heme iron partition, ascorbic acid (>=30 mg) reduction of Fe3+ to Fe2+, MFP factor, and phytate/tannin inhibition."
    },
    "FAO_AA_2007": {
      "code": "FAO_AA_2007",
      "citation": "WHO/FAO/UNU Expert Consultation (2007). Protein and Amino Acid Requirements in Human Nutrition (WHO Technical Report Series 935).",
      "scope": "Adult indispensable amino acid reference scoring pattern (g per 100g protein) for cereal+legume complementation."
    },
    "UNLU_2005_CAROTENOIDS": {
      "code": "UNLU_2005_CAROTENOIDS",
      "citation": "Unlu, N. Z., Bohn, T., Clinton, S. K., & Schwartz, S. J. (2005). Carotenoid absorption from salad and salsa by humans is enhanced by the addition of avocado or avocado oil; Fielding et al. (2005) cis-lycopene thermal isomerization.",
      "scope": "Biliary micellization threshold (>=5g lipids in meal) for fat-soluble vitamins/carotenoids and thermal trans->cis lycopene boost."
    },
    "SONI_RS3_RETROGRADATION": {
      "code": "SONI_RS3_RETROGRADATION",
      "citation": "Sonia, S., Witjaksono, F., & Ridwan, R. (2015). Effect of cooling of cooked white rice on resistant starch content and glycemic response. Asia Pac J Clin Nutr, 24(4), 620–625.",
      "scope": "Amylose/amylopectin retrogradation into Type 3 Resistant Starch (RS3) after cooking and cooling >=12h at ~4°C."
    }
  },
